{
  "name": "darer-monorepo",
  "version": "1.0.0",
  "description": "Darer streaming single page application workspace",
  "main": "backend/server.js",
  "scripts": {
    "server": "node backend/server.js",
    "client": "npm --prefix frontend-react run dev",
    "install:all": "npm install && npm install --prefix frontend-react",
    "build:client": "npm --prefix frontend-react run build",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.1"
  }
}
